<odoo>
    <record id="viva_setup_wizard_form" model="ir.ui.view">
        <field name="name">viva.setup.wizard.form</field>
        <field name="model">viva.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Viva Setup">
                <p>Validate your Viva credentials and import the available wallets as bank journals.</p>
                <field name="company_id" groups="base.group_multi_company"/>
                <footer>
                    <button name="action_discover" type="object" string="Test &amp; Discover Wallets" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="viva_setup_wizard_action" model="ir.actions.act_window">
        <field name="name">Viva: Discover Wallets</field>
        <field name="res_model">viva.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="viva_setup_menu" name="Viva: Discover Wallets"
              parent="account.menu_finance_configuration"
              action="viva_setup_wizard_action" sequence="101"
              groups="account.group_account_manager"/>
</odoo>
