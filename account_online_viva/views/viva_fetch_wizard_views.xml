<odoo>
    <record id="viva_fetch_wizard_action" model="ir.actions.act_window">
        <field name="name">Fetch Viva Transactions</field>
        <field name="res_model">viva.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="viva_fetch_wizard_form" model="ir.ui.view">
        <field name="name">viva.fetch.wizard.form</field>
        <field name="model">viva.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Fetch Viva Transactions">
                <div class="mb-3">
                    Import transactions for a specific period. Already imported
                    transactions are skipped and the automatic schedule is not affected.
                </div>
                <group>
                    <group>
                        <field name="viva_account_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_from" string="From"/>
                        <field name="date_to" string="To"/>
                    </group>
                </group>
                <footer>
                    <button name="action_fetch" type="object" string="Fetch Transactions" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
