<odoo>
    <record id="viva_fetch_wizard_action" model="ir.actions.act_window">
        <field name="name">Fetch Viva Transactions</field>
        <field name="res_model">viva.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="viva_fetch_wizard_form" model="ir.ui.view">
        <field name="name">viva.fetch.wizard.form</field>
        <field name="model">viva.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Fetch Viva Transactions">
                <group>
                    <field name="viva_account_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_fetch" type="object" string="Fetch" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
