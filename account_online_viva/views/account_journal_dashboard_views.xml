<odoo>
    <!-- Same placement and wording as Odoo's own online-sync card: a
         "Fetch Transactions" link with a status line under the buttons. -->
    <record id="account_journal_dashboard_kanban_viva" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.viva</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <field name="bank_account_id" position="after">
                <field name="viva_account_id"/>
                <field name="viva_last_successful_to"/>
                <field name="viva_last_error"/>
            </field>
            <!-- A connected Viva journal is not an "empty, connect your bank" journal.
                 Only the parent's condition is touched: Enterprise's online-sync view
                 matches the inner span by its exact t-if, so editing that would break it. -->
            <xpath expr="//t[@name='empty_journal_helper']" position="attributes">
                <attribute name="t-if" add="!record.viva_account_id.raw_value" separator=" and "/>
            </xpath>
            <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                <div t-if="journal_type == 'bank' and dashboard.bank_statements_source == 'viva' and record.viva_account_id.raw_value"
                     class="mt-1" groups="account.group_account_basic">
                    <a type="object" name="action_viva_fetch_now" class="d-block">
                        <i class="fa fa-refresh me-1"/>Fetch Transactions
                    </a>
                    <a t-if="record.viva_last_error.raw_value" type="object" name="action_viva_open_account"
                       class="d-block text-danger" title="Open the Viva account to see the error">
                        <i class="fa fa-exclamation-triangle me-1"/>Last fetch failed
                    </a>
                    <span t-elif="record.viva_last_successful_to.raw_value" class="d-block text-muted">
                        Fetched until <field name="viva_last_successful_to"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
