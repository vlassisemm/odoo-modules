<odoo>
    <record id="viva_account_view_list" model="ir.ui.view">
        <field name="name">viva.account.list</field>
        <field name="model">viva.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="wallet_id"/>
                <field name="currency_id"/>
                <field name="last_successful_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="viva_account_view_form" model="ir.ui.view">
        <field name="name">viva.account.form</field>
        <field name="model">viva.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_viva_fetch_now" type="object"
                            string="Fetch now" class="btn-primary"
                            groups="account.group_account_user"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="wallet_id"/>
                            <field name="iban"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sync_start_date"/>
                            <field name="last_successful_to"/>
                            <field name="active"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="viva_account_action" model="ir.actions.act_window">
        <field name="name">Viva Accounts</field>
        <field name="res_model">viva.account</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="viva_account_menu" name="Viva Accounts"
              parent="account.menu_finance_configuration"
              action="viva_account_action" sequence="100"
              groups="account.group_account_manager"/>
</odoo>
